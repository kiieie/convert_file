# SharedArrayBuffer 활성화를 위한 COOP & COEP 헤더 (ffmpeg.wasm 구동 필수)
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# 정적 리소스 캐싱 정책 (CSS, JS, Assets)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# bg-remove needs COEP unsafe-none to load external AI model from CDN
/tools/bg-remove.html
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/ko/tools/bg-remove.html
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/es/tools/bg-remove.html
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/zh/tools/bg-remove.html
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# yt-meme needs COEP unsafe-none to embed the YouTube IFrame Player
/tools/yt-meme.html
  Cross-Origin-Embedder-Policy: unsafe-none

/ko/tools/yt-meme.html
  Cross-Origin-Embedder-Policy: unsafe-none

/es/tools/yt-meme.html
  Cross-Origin-Embedder-Policy: unsafe-none

/zh/tools/yt-meme.html
  Cross-Origin-Embedder-Policy: unsafe-none

# clip-view는 외부 사이트에 임베드되는 페이지라 COEP 완화 + X-Frame-Options 해제 필요
/tools/clip-view.html
  Cross-Origin-Embedder-Policy: unsafe-none
  ! X-Frame-Options

