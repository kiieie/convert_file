// Cloudflare Workers config for the static site.
// Without this file, `wrangler deploy` (production) auto-detects the static
// assets, but `wrangler versions upload` (branch/PR preview builds) fails with
// "Missing entry-point to Worker script or to assets directory".
{
  "name": "convertfile",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./"
  }
}
